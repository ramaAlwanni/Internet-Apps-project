                    },
                    "price": {
                        "type": "string"
                    },
                    "stock": {
                        "type": "integer"
                    },
                    "category_id": {
                        "type": "integer"
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "photo_url": {
                        "type": [
                            "string",
