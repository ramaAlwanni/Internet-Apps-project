# Reverb / WebSocket settings for the browser (Vite only exposes VITE_ prefixed vars)
# Copy this file to `.env` and adjust the values for your environment.
VITE_REVERB_APP_KEY=local-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http
VITE_BROADCAST_AUTH_ENDPOINT=http://localhost:8080/api/broadcasting/auth
