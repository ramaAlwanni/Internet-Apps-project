APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql-primary
DB_WRITE_HOST=mysql-primary
DB_READ_HOST=mysql-replica
DB_PORT=3306
DB_DATABASE=internet_apps
DB_USERNAME=internet_apps
DB_PASSWORD=local_dev_password
DB_ROOT_PASSWORD=local_root_password
DB_REPLICATION_USER=replicator
DB_REPLICATION_PASSWORD=local_replication_password
INVENTORY_DB_DATABASE=inventory_db
INVENTORY_DB_USERNAME=inventory
INVENTORY_DB_PASSWORD=inventory_dev_password
INVENTORY_DB_ROOT_PASSWORD=local_inventory_root_password

ORDER_STOCK_MANAGER=local
GRPC_INVENTORY_HOST=127.0.0.1:9090
GRPC_INVENTORY_TIMEOUT=5

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=order_emails_queue

# Docker Compose overrides this with Redis; database keeps direct local setup self-contained.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

